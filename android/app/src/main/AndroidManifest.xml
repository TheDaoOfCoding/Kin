<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- One of the permissions Android 14+ requires for a connectedDevice foreground service. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 17 (API 37) asks for this before an app may reach devices on the local network, including the PC. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asked for only when the user taps "Scan code" (see MainActivity.scan). The camera is optional: without one, the pairing link can be pasted. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held only while file bytes move, and let go at once (architecture.md, "Battery rules for the phone"). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ring my phone (2B.4): the Stop screen over a locked phone. A normal permission, granted at install for a sideloaded app; Google Play may revoke it on Android 14+ (risk R37), and then the ring shows as a notification with a Stop button. Ringing never depends on it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The ring vibrates (a normal permission). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Do Not Disturb sync (2B.5): a normal permission that only **names** the special access "Do Not Disturb access" (Settings > Notifications > Do Not Disturb > Apps that can interrupt, or the
        screen that Kin opens). The access itself is granted by the user, **only after** they turn on "Silence this phone while my PC is in Focus" and none exists yet: never asked at start-up. It lets Kin
        turn Do Not Disturb on and off; it does not let Kin read notifications. (Notification access, if the user already gave it for mirroring, covers it too: spike S5.)
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
        Auto-send screenshots (2B.4, opt-in): declared, but **asked for only when the user turns the switch on**, never at start-up. Kin does not declare READ_MEDIA_VISUAL_USER_SELECTED, ACCESS_MEDIA_LOCATION,
        READ_MEDIA_VIDEO or MANAGE_EXTERNAL_STORAGE. A Play build without this feature removes both (src/noshots, `-PkinAutoSendShots=false`).
        Lint's "SelectedPhotoAccess" is deliberate: Android 14's "Select photos" is a grant for one session only, which cannot work for a watcher that runs in the background, so Kin runs in the
        system's compatibility mode and shows "Needs access to all photos" when the grant is partial (design 5.6).
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
        Which apps can open a web link (2B.1): "Open in YouTube" in the link notification, and the resolve check of Android 10. This is not
        QUERY_ALL_PACKAGES. Two kinds of entries:
        - ACTION_VIEW of plain `https` / `http`: the web browsers (apps whose filter has no host), which the plan needs to tell browsers from the
          apps that own a link;
        - ACTION_VIEW of one named host: the apps that own it. Android does NOT show an app whose filter has a host (YouTube: www.youtube.com) to a
          query that names no host, found on the emulator in 2B.1, so the well-known sites are listed one by one. A site that is not listed still
          opens in its app on a tap (the system picks it); only the label is then the neutral "Open link" instead of "Open in <App>".
    -->
    <queries>
        <!--
            2B.2: the apps with a launcher icon, for the notification picker ("which apps may show notifications on your PC"). This is the usual way to
            list the apps a user knows, and it is not QUERY_ALL_PACKAGES. A Play review may ask why (risk R27).
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
