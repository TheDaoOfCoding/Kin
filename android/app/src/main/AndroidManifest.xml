    <!-- No backup: identity keys and paired devices must not be restored to another device. -->
    <application
        android:name=".KinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- kinrelay://pair?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="kinrelay" />
                <data android:host="pair" />
            </intent-filter>
            <!--
                https://<any host>/pair#... : any host for now, see protocol.md "Parsing rules". It can't be
                verified (autoVerify) because there is no domain yet; the phone pins the PC by ID instead.
            -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="*" />
                <data android:path="/pair" />
                <data android:path="/pair/" />
            </intent-filter>
            <!-- The direct-share target (the paired PC in the share sheet's top row): see ShareShortcuts. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Share sheet: text and files of any type, one or many. No UI: it hands them to the sender and finishes.
            Exported on purpose: any app may offer text or files to Kin, and the user picks Kin in the share sheet (risk R13).
        -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kin.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The QR scanner. Not exported: only MainActivity starts it, after the camera permission was granted. -->
        <activity
            android:name=".scan.ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.Kin" />

        <!-- "Send to PC" in the text selection menu. -->
        <activity
            android:name=".share.ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/send_to_pc"
            android:taskAffinity=""
            android:theme="@style/Theme.Kin.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Reads the clipboard while it has focus and sends it. Not exported: only our own tile and notification
            button start it. (The adb shell may start it for tests, see android/README.md.)
        -->
        <activity
            android:name=".clipboard.ClipboardSendActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kin.Transparent" />

        <!--
            The tap on a link notification: opens the link in the app that owns it (or the browser) and finishes. No UI. Not exported: only our own
            PendingIntents start it (a notification may not trampoline through a service or a receiver on Android 12+).
        -->
        <activity
            android:name=".links.LinkOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kin.Transparent" />

        <service
            android:name=".clipboard.SendClipboardTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_kin"
            android:label="@string/send_clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- "Export logs" on the Debug screen: the zip is read by the app the user picks in the share sheet, through a grant on the intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            Notification mirroring (2B.2), opt-in: the user gives Kin "Notification access" in the system settings (a special access: there is no
            permission to ask for), and ticks the apps whose notifications may appear on the PC. The label is what the user sees in that list.
        -->
        <service
            android:name=".notifmirror.MirrorListenerService"
            android:exported="true"
            android:label="@string/mirror_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The buttons and the swipe of the notification that shows the PC's media (2B.3). Only our own PendingIntents reach it. -->
        <receiver
            android:name=".media.PcMediaReceiver"
            android:exported="false" />

        <!-- The Cancel and Retry buttons of the transfer notifications. Only our own PendingIntents reach it. -->
        <receiver
            android:name=".transfer.TransferActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".link.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
