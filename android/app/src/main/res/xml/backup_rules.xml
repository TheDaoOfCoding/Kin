<?xml version="1.0" encoding="utf-8"?>
<!--
   Phase 1 stores identity keys and paired devices. They must never be restored to
   another device, so exclude everything. Used on Android 11 and older.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
